# ============================================================
# Template deploy / mesin baru. Salin ke file `.env` lalu isi.
# JANGAN commit file `.env`.
# ============================================================

# --- PostgreSQL (DB server terpisah = isi IP database server) ---
CTF_DB_HOST=127.0.0.1
CTF_DB_PORT=5432
CTF_DB_USER=ctf
CTF_DB_PASSWORD=ganti-ini
CTF_DB_NAME=ctf_db

# --- Password akun admin hanya dipakai saat tabel accounts kosong ---
CTF_ADMIN_PASSWORD=ganti-ini
CTF_SUPER_PASSWORD=ganti-ini

# --- Nonaktifkan deteksi/autostart PostgreSQL (Docker) di server ini ---
# Set 1 kalau PostgreSQL DIHOST oleh mesin lain (server DB terpisah).
CTF_NO_PG_AUTOSTART=1

# --- Opsional ---
# CTF_PORT=8877
# CTF_BIND=127.0.0.1   # 0.0.0.0 hanya kalau expose langsung (tanpa nginx)