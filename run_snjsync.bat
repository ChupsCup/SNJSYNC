@echo offcd /d "%~dp0"set "SNJ_PORT=8877"set "SNJ_URL=http://localhost:%SNJ_PORT%"echo ========================================echo    SNJSYNC - Web Lokalecho ========================================echo.if not exist "snjsync.exe" (    echo [ERROR] snjsync.exe tidak ditemukan!    echo Mencoba build ulang...    echo.    go build -o snjsync.exe .    if %ERRORLEVEL% NEQ 0 (        echo [ERROR] Build gagal!        pause        exit /b 1    )    echo [OK] Build berhasil!    echo.)set "PID="for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":%SNJ_PORT% " ^| findstr LISTENING') do set PID=%%aif defined PID (    echo [INFO] Port %SNJ_PORT% sudah dipakai oleh PID %PID%    echo Mungkin SNJSYNC sudah berjalan...    echo.    echo Membuka browser...    start "" "%SNJ_URL%/?r=%RANDOM%%RANDOM%"    timeout /t 4 /nobreak >nul    exit /b 0)echo [START] Menjalankan SNJSYNC...echo Root: %CD%echo URL:  %SNJ_URL%echo.echo Browser akan terbuka otomatis. Tekan Ctrl+C untuk menghentikan server.echo.snjsync.exeecho.echo Server berhenti.pause